# Copy to .env.local and fill in.

# Required — cast classification (Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-...

# Required — question embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Optional — market persistence. Without these the app uses an in-memory
# store that resets on every process restart (fine locally, useless on
# serverless). Create a free Redis DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — pins the absolute origin used in snap embed URLs. Inferred from
# request headers when unset; set it if the inferred host is wrong.
# NEXT_PUBLIC_BASE_URL=https://takes-miniapp.vercel.app
